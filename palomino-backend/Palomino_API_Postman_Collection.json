          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"PasswordIncorrecto123!\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["auth", "login"]
        },
        "description": "Password incorrecto (400 Bad Request)"
      }
    },
    {
      "name": "Login User - Non-existent User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"usuario.inexistente@example.com\",\n  \"password\": \"AnyPassword123!\"\n}"
        },
        "url": {
